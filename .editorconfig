root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,js,mjs,ts,mts,vue,css,xml,json,json5}]
indent_size = 2

# Code blocks may contain tabs
[*.md]
indent_style = unset
trim_trailing_whitespace = false

# Tatra banka's WSDL/XSD files are kept as delivered
[src/ComfortPay/*.{wsdl,xsd}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
