includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    # Level 6+ needs native or PHPDoc types for every Omnipay parameter accessor (hundreds of them).
    level: 5
    paths:
        - src
        - tests
    strictRules:
        # Signatures are compared with hash_equals() (Omnipay\Core\Sign\Signature). The remaining loose
        # comparisons (variable symbols, response statuses, key lengths) and empty() checks are payment logic;
        # making them strict changes behaviour, so it is left for a dedicated change.
        disallowedLooseComparison: false
        disallowedEmpty: false
