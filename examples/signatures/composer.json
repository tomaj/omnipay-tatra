{
    "name": "tomaj/omnipay-tatra-example-signatures",
    "description": "omnipay-tatra example: signatures",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "tomaj/omnipay-tatra": "5.0.x-dev",
        "php-http/guzzle7-adapter": "^1.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true,
                "versions": {
                    "tomaj/omnipay-tatra": "5.0.x-dev"
                }
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
